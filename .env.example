# Backend server
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require
PORT=3001

# Frontend (dev only — for production, set in Vercel dashboard)
VITE_API_URL=http://localhost:3001

# Token encryption key (64 hex chars = 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# CORS allowed origins (comma-separated for multiple)
# Dev: http://localhost:5173
# Prod: https://stage.phantom.name.ng,https://api.stage.phantom.name.ng
CORS_ORIGIN=http://localhost:5173
